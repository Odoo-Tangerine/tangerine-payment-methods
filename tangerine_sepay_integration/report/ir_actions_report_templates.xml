<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_saleorder_document_inherit_sepay" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='total']/div[last()]" position="before">
            <t t-if="doc.company_id.default_bank_account_id">
                <div class="col-6 col-sm-5 col-md-6 text-center">
                    <img t-attf-src="https://qr.sepay.vn/img?acc=#{doc.company_id.default_bank_account_id.acc_number}&amp;bank=#{doc.company_id.default_bank_account_id.bank_id.code}&amp;amount=#{doc.amount_total}&amp;des=#{doc.name}" style="width:30%; height:auto;" alt="QR Code" class="mx-auto d-block" />
                    <h6 class="mt-1">Scan to pay</h6>
                </div>
            </t>
        </xpath>
    </template>
</odoo>