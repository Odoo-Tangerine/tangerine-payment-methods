<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="sale_order_portal_template_inherit_sepay" name="Sales Order" inherit_id="sale.sale_order_portal_content">
        <div id="total" position="inside">
            <t t-if="sale_order.company_id.default_bank_account_id">
                <div class="col-3 text-center position-absolute top-0 start-0">
                    <img t-attf-src="https://qr.sepay.vn/img?acc=#{sale_order.company_id.default_bank_account_id.acc_number}&amp;bank=#{sale_order.company_id.default_bank_account_id.bank_id.code}&amp;amount=#{sale_order.amount_total}&amp;des=#{sale_order.name}" style="width:50%; height:auto;" alt="QR Code" />
                    <h6 class="mt-1">Scan to pay</h6>
                </div>
            </t>
        </div>
    </template>
</odoo>