<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_invoice_document_inherit_sepay" inherit_id="account.report_invoice_document">
        <div id="qrcode_image" position="replace">
            <div class="qrcode me-3" id="qrcode_image">
                <t t-set="qr_code_url" t-value="o._generate_qr_code(silent_errors=True)"/>
                <p t-if="qr_code_url and o.company_id.country_code == 'VN' and o.qr_code_method == 'sepay_qr'" class="position-relative mb-0">
                    <img t-att-src="qr_code_url" width="128px" height="128px"/>
                </p>
                <p t-elif="qr_code_url" class="position-relative mb-0">
                    <img t-att-src="qr_code_url"/>
                    <img src="/account/static/src/img/Odoo_logo_O.svg"
                         id="qrcode_odoo_logo"
                         class="top-50 start-50 position-absolute bg-white border border-white border-3 rounded-circle"
                    />
                </p>
            </div>
        </div>
    </template>
</odoo>