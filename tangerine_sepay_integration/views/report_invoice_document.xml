<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_invoice_document_inherit_sepay" inherit_id="account.report_invoice_document">
        <div id="qrcode" position="replace">
            <div id="qrcode" t-if="o.display_qr_code and o.amount_residual > 0">
                <p t-if="qr_code_urls.get(o.id)">
                    <strong class="text-center">Scan me with your banking app.</strong><br/><br/>
                    <t t-if="o.company_id.country_code == 'VN' and o.qr_code_method == 'sepay_qr'">
                        <img t-att-src="qr_code_urls[o.id]" width="128px" height="128px"/>
                    </t>
                    <t t-else="">
                        <img class="border border-dark rounded" t-att-src="qr_code_urls[o.id]"/>
                    </t>
                </p>
            </div>
        </div>
    </template>
</odoo>